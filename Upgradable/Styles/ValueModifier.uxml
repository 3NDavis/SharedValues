<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement style="flex-grow: 1; background-color: rgb(77, 77, 77); border-top-left-radius: 4px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; border-top-right-radius: 4px; border-top-width: 6px; border-left-width: 6px; border-bottom-width: 6px; border-right-width: 6px;">
        <ui:VisualElement name="Domains" style="flex-grow: 1;">
            <ui:FloatField label="Min Domain" value="42.2" binding-path="minDomain"/>
            <ui:FloatField label="Max Domain" value="42.2" binding-path="maxDomain"/>
            <ui:FloatField label="Default Domain" value="42.2" binding-path="defaultDomainValue"/>
        </ui:VisualElement>
        <ui:FloatField label="Step Value" value="42.2" binding-path="stepValue"/>
        <ui:EnumField label="Modification Type" value="Center" type="UnityEngine.TextAlignment, UnityEngine.TextRenderingModule" binding-path="modificationType" name="modificationType"/>
        <ui:FloatField label="S/Z Curve Slope" value="42.2" binding-path="sCurveSlope" name="sCurveSlope"/>
        <uie:CurveField label="Custom Curve" value="{0,0,0,0,0,0,Free,Free,False,None};{5,8,0,0,0,0,Free,Free,False,None};{10,4,0,0,0,0,Free,Free,False,None}+(ClampForever,ClampForever)" binding-path="curve" name="animCurve"/>
        <ui:EnumField label="Vector Mod Component" value="Center" type="UnityEngine.TextAlignment, UnityEngine.TextRenderingModule" binding-path="vectorVariableToModify" name="vectorModType"/>
    </ui:VisualElement>
</ui:UXML>
