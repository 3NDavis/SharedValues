<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement style="flex-grow: 1; background-color: rgb(77, 77, 77); border-top-left-radius: 4px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; border-top-right-radius: 4px; border-top-width: 6px; border-left-width: 6px; border-bottom-width: 6px; border-right-width: 6px; margin-top: 2px; margin-right: 0; margin-bottom: 2px; margin-left: 0;">
        <ui:Label text="Label" name="Label"/>
        <uie:PropertyField name="BaseValue" label="" binding-path="baseValue" style="margin-top: -6px; margin-bottom: -10px;"/>
        <uie:PropertyField name="PostModValue" label="Post Mods Value" enabled="false" binding-path="postModificationValue"/>
        <uie:PropertyField name="ValueModifiers" label="Modifiers" view-data-key="" binding-path="modifiers"/>
    </ui:VisualElement>
</ui:UXML>
