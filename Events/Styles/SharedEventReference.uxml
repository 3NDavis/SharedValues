<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:VisualElement style="flex-grow: 1; border-top-width: 4px; border-bottom-width: 4px;">
        <ui:VisualElement name="VisualElement" style="flex-grow: 1; border-left-width: 6px; border-right-width: 6px; border-top-width: 6px; border-bottom-width: 6px; -unity-background-image-tint-color: rgb(255, 255, 255); background-color: rgb(77, 77, 77); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px;">
            <ui:VisualElement style="flex-grow: 1; flex-direction: row; align-self: auto; justify-content: space-between; align-items: auto; margin-bottom: 2px; padding-right: 0; align-content: auto;">
                <ui:Label text="Label" name="OutVarLabel" style="padding-right: 12px; margin-bottom: 3px;"/>
                <uie:PropertyField label="" view-data-key="actualValue" binding-path="actualValue" enabled="true" name="OutVar" style="width: 80%;"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                <ui:EnumField label="" binding-path="referenceType" name="ReferenceType"/>
                <ui:VisualElement enabled="true" data-source-path="" view-data-key="" name="Variables" style="border-left-width: 14px; border-top-width: 2px; visibility: visible; flex-direction: column; flex-shrink: 1; display: flex; flex-grow: 1; overflow: visible;">
                    <uie:PropertyField binding-path="evt" label="Event" view-data-key="" data-source-path="" name="SharedEvent"/>
                    <uie:PropertyField binding-path="instanceGroup" label="Instancer" view-data-key="Instancer" data-source-path="" name="Instancer"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
